# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Provider (OpenAI-compatible — ai-box)
AI_BASE_URL=https://api.ai-box.vn/v1
AI_MODEL=deepseek-v4-flash-0731
AI_API_KEY=your_ai_box_api_key
# Model ảnh cho mockup in (bỏ trống → qwen-image-3.0)
# AI_IMAGE_MODEL=qwen-image-3.0

# Cloudinary — nơi lưu ảnh mockup + khuôn bế có hình in (server-side signed upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Tùy chọn: preset "unsigned" trong Cloudinary console (folder ép trong preset).
# Đặt vào → bỏ qua chữ ký HMAC (lách lỗi 401 "Invalid Signature" ở tài khoản mới).
# CLOUDINARY_UPLOAD_PRESET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase Edge Function URL (if using)
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=
# OTP email verification (tự gửi qua Gmail, thay Supabase Confirm email)
GMAIL_ADDRESS=you@gmail.com
# App Password (2-Step Verification -> myaccount.google.com/apppasswords), 16 ký tự
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
